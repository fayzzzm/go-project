### ============================================================================
### TENANTS
### ============================================================================

### 1a. List Tenants
# @name listTenants
GET {{baseUrl}}/tenants
Content-Type: application/json

### 1b. List Tenant Users
# @name listTenantUsers
GET {{baseUrl}}/tenants/users
Authorization: Bearer {{authToken}}
Content-Type: application/json
X-Tenant-ID: {{tenantId}}

### ============================================================================
### AUTHENTICATION
### ============================================================================

### 1c. Login
# @name login
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "email": "admin@itsware.com",
    "password": "{{password}}"
}


### ============================================================================
### USERS
### ============================================================================

### 2. Create User
# @name createUser
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Tenant-ID: {{tenantId}}

{
    "email": "developer@itsware.com",
    "password": "{{password}}",
    "name": "10x Developer",
    "address": "Silicon Valley",
    "phone": "+1-555-0199",
    "app_metadata": {
        "role": "admin",
        "permissions": ["all"]
    },
    "user_metadata": {
        "theme": "dark"
    }
}

### 3. Get User By ID
GET {{baseUrl}}/users/{{createdUserId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Tenant-ID: {{tenantId}}

### 4. Update User
PUT {{baseUrl}}/users/{{createdUserId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Tenant-ID: {{tenantId}}

{
    "name": "Lalante Developer"
}

### 6. Delete User 
DELETE {{baseUrl}}/users/{{createdUserId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Tenant-ID: {{tenantId}}


### ============================================================================
### TEAMS
### ============================================================================

### 7. Create Team
# @name createTeam
POST {{baseUrl}}/teams
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Tenant-ID: {{tenantId}}

{
    "name": "Lalante Ops Team",
    "status": "active"
}

### 8. List Teams
GET {{baseUrl}}/teams
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Tenant-ID: {{tenantId}}

### 9. Add Member to Team
# @name addMember
POST {{baseUrl}}/teams/{{createdTeamId}}/members
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Tenant-ID: {{tenantId}}

{
    "user_id": "{{createdUserId}}",
    "role": "admin"
}

### 10. List Teams for User
GET {{baseUrl}}/teams?user_id={{createdUserId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Tenant-ID: {{tenantId}}


### ============================================================================
### CABINETS
### ============================================================================

### 11. Create Cabinet
# @name createCabinet
POST {{baseUrl}}/cabinets
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Tenant-ID: {{tenantId}}

{
    "name": "Main Server Rack",
    "location": "Building A, Floor 2",
    "team_id": "{{createdTeamId}}"
}

### 12. List Cabinets
GET {{baseUrl}}/cabinets
Content-Type: application/json
X-Tenant-ID: {{tenantId}}
Authorization: Bearer {{authToken}}


### ============================================================================
### DEVICE PROFILES
### ============================================================================

### 13. Create Device Profile
# @name createProfile
POST {{baseUrl}}/device_profiles
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Tenant-ID: {{tenantId}}

{
    "name": "Handheld RFID Reader",
    "description": "Zebra MC3300 Models"
}

### 14. List Device Profiles
GET {{baseUrl}}/device_profiles
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Tenant-ID: {{tenantId}}


### ============================================================================
### DEVICES
### ============================================================================

### 15. Create Device
# @name createDevice
POST {{baseUrl}}/devices
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Tenant-ID: {{tenantId}}

{
    "name": "RFID Reader X12",
    "description": "Main entrance reader",
    "serial_number": "SN-2026-005",
    "epc": "EPC:3039",
    "device_profile_id": "{{createdProfileId}}",
    "cabinet_id": "{{createdCabinetId}}",
    "team_id": "{{createdTeamId}}",
    "tenant_id": "{{tenantId}}"
}

### 16. List Devices
GET {{baseUrl}}/devices
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Tenant-ID: {{tenantId}}


### 17. Get Device By ID
GET {{baseUrl}}/devices/{{createdDeviceId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Tenant-ID: {{tenantId}}

### 18. Update Device
PUT {{baseUrl}}/devices/{{createdDeviceId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Tenant-ID: {{tenantId}}

{
    "name": "RFID Reader X1 (Updated)",
    "description": "Updated description",
    "serial_number": "SN-2026-004-UPD"
}

### 19. Delete Device
DELETE {{baseUrl}}/devices/{{createdDeviceId}}
Content-Type: application/json
Authorization: Bearer {{authToken}}
X-Tenant-ID: {{tenantId}}
